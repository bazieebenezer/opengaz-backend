generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CONSUMER
  SELLER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          Role      @default(CONSUMER)
  name          String?
  phone         String?
  address       String?
  neighborhood  String?
  landmark      String?
  
  // Seller specific fields
  shopName      String?
  shopImage     String?
  selectedGases String[]
  region        String?
  openingHours  String?
  openingTime   String?
  closingTime   String?
  description   String?

  products      Product[] @relation("SellerProducts")
  orders        Order[]   @relation("ConsumerOrders")
  sellerOrders  Order[]   @relation("SellerOrders")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TempUser {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String
  otp           String
  expiresAt     DateTime
  
  // Seller specific fields
  phone         String?
  address       String?
  neighborhood  String?
  landmark      String?
  shopName      String?
  shopImage     String?
  selectedGases String[]
  region        String?
  openingHours  String?
  openingTime   String?
  closingTime   String?
  description   String?

  createdAt     DateTime @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int         @default(0)
  imageUrl    String?
  seller      User        @relation("SellerProducts", fields: [sellerId], references: [id])
  sellerId    String
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  totalAmount Float
  
  consumer    User        @relation("ConsumerOrders", fields: [consumerId], references: [id])
  consumerId  String
  
  seller      User        @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId    String
  
  items       OrderItem[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
}
