generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CONSUMER
  SELLER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          Role      @default(CONSUMER)
  name          String?
  phone         String?
  address       String?
  neighborhood  String?
  landmark      String?
  latitude      Float?
  longitude     Float?
  
  // Seller specific fields
  shopName      String?
  shopImage     String?
  selectedGases String[]
  region        String?
  openingHours  String?
  openingTime   String?
  closingTime   String?
  description   String?
  isShopOpen    Boolean   @default(true)

  // Password Reset fields
  resetPasswordOtp     String?
  resetPasswordExpires DateTime?

  products      Product[] @relation("SellerProducts")
  orders        Order[]   @relation("ConsumerOrders")
  sellerOrders  Order[]   @relation("SellerOrders")
  
  reviews       Review[]  @relation("SellerReviews")
  givenReviews  Review[]  @relation("ConsumerReviews")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TempUser {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String
  otp           String
  expiresAt     DateTime
  
  // Seller specific fields
  phone         String?
  address       String?
  neighborhood  String?
  landmark      String?
  latitude      Float?
  longitude     Float?
  shopName      String?
  shopImage     String?
  selectedGases String[]
  region        String?
  openingHours  String?
  openingTime   String?
  closingTime   String?
  description   String?

  createdAt     DateTime @default(now())
}

model Product {
  id          String      @id @default(cuid())
  stock       Int         @default(0)
  
  category    GasCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  
  seller      User        @relation("SellerProducts", fields: [sellerId], references: [id])
  sellerId    String
  
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model GasCategory {
  id        String    @id
  name      String
  brand     String
  weight    Float
  price     Float
  imageUrl  String
  products  Product[]
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

model Order {
  id             String      @id @default(cuid())
  status         OrderStatus @default(PENDING)
  totalAmount    Float
  consumerHidden Boolean     @default(false)
  sellerHidden   Boolean     @default(false)
  
  consumer       User        @relation("ConsumerOrders", fields: [consumerId], references: [id])
  consumerId     String
  
  seller         User        @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId       String
  
  items          OrderItem[]
  review         Review?
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // de 1 à 5
  comment   String?
  
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String   @unique
  
  seller    User     @relation("SellerReviews", fields: [sellerId], references: [id])
  sellerId  String
  
  consumer  User     @relation("ConsumerReviews", fields: [consumerId], references: [id])
  consumerId String

  createdAt DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
}
